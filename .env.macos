# MongoDB config
MONGO_DATABASE=petra
MONGO_USERNAME=petra
MONGO_PASSWORD=petra
MONGO_ADMIN_USERNAME=root
MONGO_ADMIN_PASSWORD=root

MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=root
MONGO_INITDB_DATABASE=petra
MONGO_INITDB_USERNAME=petra
MONGO_INITDB_PASSWORD=petra


#petra_central_control variables
ROS_DOMAIN_ID=8
# ROS2
# MAP_SERVICE_NAME=map_server/map
# PATH_TOPIC_NAME=/plan
# POSITION_TOPIC_NAME=/shg/current_position
# ROS1
MAP_SERVICE_NAME=/static_map
PATH_TOPIC_NAME=/move_base/NavfnROS/plan
POSITION_TOPIC_NAME=/nav/current_position

#petra_web config

#petra service locations (may need adjusting if not hosted on the same machine)
# NUC
# MONGO_HOSTNAME=172.31.1.235:27017
# PETRA_DATABASE_URI=mongodb://172.31.1.235:27017
# FLASK_MOUNT_URL=http://172.31.1.235:5000
# FLASK_BACKEND_URL=http://172.31.1.235:5000
# PETRA_FRONTEND_URL=https://172.31.1.235:3000

# Proximity Router
# MONGO_HOSTNAME=192.168.9.235:27017
# PETRA_DATABASE_URI=mongodb://192.168.9.235:27017
# FLASK_MOUNT_URL=http://192.168.9.235:5000
# FLASK_BACKEND_URL=http://192.168.9.235:5000
# PETRA_FRONTEND_URL=https://192.168.9.235:3000

# Local development
MONGO_HOSTNAME=host.docker.internal:27017
PETRA_DATABASE_URI=mongodb://host.docker.internal:27017
# FLASK_MOUNT_URL: the url the backend is mounted to. Usually the same as FLASK_BACKEND_URL
FLASK_MOUNT_URL=http://0.0.0.0:5000
# FLASK_BACKEND_URL: the url the backend is reachable on
FLASK_BACKEND_URL=http://0.0.0.0:5000
PETRA_FRONTEND_URL=http://host.docker.internal:3000

WAIT_HOSTS=host.docker.internal:27017
WAIT_AFTER=10
PETRA_PATH=""